<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/dasBoard.css">
</head>

<body>
  <main>
    <%- include('partials/leftPartial') %>


      <% let studentCount=0;
         let professorCount=0;
         let hodCount=0;
         let totalDepartments = 0;
      
      // guard against empty or undefined `data` and `deptCount`
      if (Array.isArray(data)) {
        data.forEach(item=> {
          if (!item || typeof item !== 'object') return;
          const id = item._id || '';
          if (id === 'Student') studentCount = item.countUsers || 0;
          if (id === 'Professor') professorCount = item.countUsers || 0;
          // handle variations like 'HOD' and 'H.O.D'
          if (id === 'HOD' || id === 'H.O.D' || id === 'H.O.D.') hodCount = item.countUsers || 0;
        });
      }

      if (Array.isArray(deptCount) && deptCount.length > 0 && deptCount[0]) {
        totalDepartments = deptCount[0].totalDepartments || 0;
      }
        %>


        <div id="right">
          <h1 id="dash">Dashboard Overview</h1>

          <div class="stats-container">
            <div class="box light-blue">
              <p class="label">Total Departments</p>
              <p class="value"><%= totalDepartments %></p>
            </div>

            <div class="box light-green">
              <p class="label">Total Students</p>
              <p class="value"><%=studentCount%></p>
            </div>

            <div class="box light-orange">
              <p class="label">Total Professors</p>
              <p class="value"><%=professorCount%></p>
            </div>

            <div class="box light-purple">
              <p class="label">Total HODs</p>
              <p class="value"><%=hodCount%></p>
            </div>
          </div>
        </div>
  </main>
</body>

</html>
