<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/dasBoard.css">
</head>

<body>
  <main>
    <%- include('partials/leftPartial') %>


      <% let studentCount=0;
         let professorCount=0;
         let hodCount=0;
      
      data.forEach(item=> {
        if (item._id === 'Student') studentCount = item.countUsers;
        if (item._id === 'Professor') professorCount = item.countUsers;
        if (item._id === 'HOD') hodCount = item.countUsers;
        });
        %>


        <div id="right">
          <h1 id="dash">Dashboard Overview</h1>

          <div class="stats-container">
            <div class="box light-blue">
              <p class="label">Total Departments</p>
              <p class="value"><%= deptCount[0].totalDepartments %></p>
            </div>

            <div class="box light-green">
              <p class="label">Total Students</p>
              <p class="value"><%=studentCount%></p>
            </div>

            <div class="box light-orange">
              <p class="label">Total Professors</p>
              <p class="value"><%=professorCount%></p>
            </div>

            <div class="box light-purple">
              <p class="label">Total HODs</p>
              <p class="value"><%=hodCount%></p>
            </div>
          </div>
        </div>
  </main>
</body>

</html>