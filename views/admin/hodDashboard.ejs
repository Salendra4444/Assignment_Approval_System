<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOD Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
    <header class="bg-slate-900 text-white px-8 py-5 flex justify-between items-center">
        <div>
            <p class="text-sm text-slate-300">Academic Administration</p>
            <h1 class="text-2xl font-semibold">Head of Department Dashboard</h1>
        </div>
        <div class="text-right">
            <p class="font-medium"><%= hod.name %></p>
            <a href="/hod/profile" class="text-sm text-slate-300 hover:text-white">Profile</a>
            <span class="text-slate-500 mx-1">|</span>
            <a href="/logout" class="text-sm text-slate-300 hover:text-white">Logout</a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-8">
        <div class="flex justify-between items-end mb-6">
            <div>
                <h2 class="text-2xl font-semibold text-slate-800">Department assignment tracking</h2>
                <p class="text-slate-500 mt-1">Track teacher checks and complete the HOD decision for your department.</p>
            </div>
            <div class="flex flex-wrap gap-2 text-sm font-medium">
                <span class="bg-slate-200 text-slate-700 px-3 py-2 rounded-lg"><%= dashboardStats.total %> tracked</span>
                <span class="bg-emerald-100 text-emerald-800 px-3 py-2 rounded-lg"><%= dashboardStats.checked %> teacher checked</span>
                <span class="bg-amber-100 text-amber-800 px-3 py-2 rounded-lg"><%= dashboardStats.waitingForTeacher %> awaiting teacher</span>
                <span class="bg-blue-100 text-blue-800 px-3 py-2 rounded-lg"><%= dashboardStats.waitingForHod %> awaiting HOD</span>
            </div>
        </div>

        <% if (assignmentRows.length === 0) { %>
            <div class="bg-white border rounded-xl p-12 text-center text-slate-500 shadow-sm">
                No submitted assignments are available for this department.
            </div>
        <% } %>

        <div class="space-y-5">
            <% assignmentRows.forEach(({ assignment, student, teacherChecked }) => { %>
                <article class="bg-white border rounded-xl shadow-sm p-6">
                    <div class="flex flex-wrap justify-between gap-4">
                        <div>
                            <p class="text-xs uppercase tracking-wide text-slate-500">Student submission</p>
                            <h3 class="text-xl font-semibold text-slate-800 mt-1"><%= assignment.title %></h3>
                            <p class="text-slate-600 mt-1"><%= student?.name || 'Student account unavailable' %> · <%= student?.email || 'Unknown student' %></p>
                        </div>
                        <% if (assignment.status === 'HOD Review') { %>
                            <span class="h-fit bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm">Awaiting HOD review</span>
                        <% } else if (teacherChecked) { %>
                            <span class="h-fit bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-sm">Teacher checked</span>
                        <% } else { %>
                            <span class="h-fit bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-sm">Teacher has not checked</span>
                        <% } %>
                    </div>

                    <div class="grid md:grid-cols-5 gap-4 mt-5 text-sm">
                        <div class="bg-slate-50 rounded-lg p-4"><span class="text-slate-500 block">Department</span><strong><%= student?.departement || 'All departments' %></strong></div>
                        <div class="bg-slate-50 rounded-lg p-4"><span class="text-slate-500 block">Category</span><strong><%= assignment.category %></strong></div>
                        <div class="bg-slate-50 rounded-lg p-4"><span class="text-slate-500 block">Assignment status</span><strong><%= assignment.status %></strong></div>
                        <div class="bg-slate-50 rounded-lg p-4"><span class="text-slate-500 block">Teacher review</span><strong><%= teacherChecked ? assignment.professorReviewedBy : 'Not checked yet' %></strong><% if (teacherChecked && assignment.professorReviewedAt) { %><span class="block text-xs text-slate-500 mt-1"><%= new Date(assignment.professorReviewedAt).toLocaleString() %></span><% } %></div>
                        <div class="bg-slate-50 rounded-lg p-4"><span class="text-slate-500 block">Professor remarks</span><strong><%= assignment.professorRemarks || 'No remarks provided' %></strong></div>
                    </div>

                    <p class="text-slate-700 mt-5"><%= assignment.description %></p>

                    <% if (assignment.status === 'HOD Review') { %>
                    <form action="/hod/assignment/<%= assignment._id %>/review" method="POST" class="mt-6 border-t pt-5">
                        <label class="block text-sm font-medium text-slate-700 mb-2" for="remarks-<%= assignment._id %>">HOD remarks</label>
                        <textarea id="remarks-<%= assignment._id %>" name="remarks" rows="2" required class="w-full border rounded-lg p-3" placeholder="Record the academic or administrative decision..."></textarea>
                        <div class="flex gap-3 mt-4">
                            <button name="action" value="approve" class="bg-emerald-600 text-white px-5 py-2 rounded-lg hover:bg-emerald-700">Approve for final submission</button>
                            <button name="action" value="reject" class="bg-red-600 text-white px-5 py-2 rounded-lg hover:bg-red-700">Return to student</button>
                        </div>
                    </form>
                    <% } %>
                </article>
            <% }) %>
        </div>
    </main>
</body>
</html>