<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Departments</title>
  <link rel="stylesheet" href="/Departments.css">
</head>

<body>
  <main>

    <%- include('partials/leftPartial') %>

    <div id="right">

      <!-- HEADER + ADD BUTTON -->
      <div class="header-section">
        <h1>View All Departments</h1>
        <button class="add-btn">
          <a id="add" href="/addDepartment">+ Add Department</a>
        </button>
      </div>

      <!-- FILTERS + SEARCH -->
      <div class="filters-container">

        <form action="/Departments" method="GET" class="filter-form">

          <!-- Search -->
          <input 
            type="text"
            name="search"
            placeholder="Search department..."
            value="<%= search || '' %>"
            class="search-input"
          />

          <!-- Programme Type Filter -->
          <select name="programmeType" class="filter-select">
            <option value="">All Programme Types</option>
            <option value="Diploma" <%= programmeType === 'Diploma' ? 'selected' : '' %>>Diploma</option>
            <option value="Undergraduate" <%= programmeType === 'Undergraduate' ? 'selected' : '' %>>Undergraduate</option>
            <option value="Postgraduate" <%= programmeType === 'Postgraduate' ? 'selected' : '' %>>Postgraduate</option>
          </select>

          <!-- Address Filter -->
          <select name="address" class="filter-select">
            <option value="">All Locations</option>

            <% addressList.forEach(addr => { %>
              <option 
                value="<%= addr %>"
                <%= address === addr ? 'selected' : '' %>>
                <%= addr %>
              </option>
            <% }) %>

          </select>

          <button type="submit" class="apply-btn">Apply</button>
        </form>

      </div>

      <!-- TABLE DATA -->
      <table class="departments-table">
        <thead>
          <tr>
            <th>Department Name</th>
            <th>Programme Type</th>
            <th>Address</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>

          <% if (data && data.length > 0) { %>

            <% data.forEach((dept) => { %>
              <tr>
                <td><%= dept.departmentName %></td>
                <td><%= dept.programmeType %></td>
                <td><%= dept.address %></td>

                <td>
                  <a href="/editDepartment/<%= dept._id %>" class="edit-btn">Edit</a>

                  <form action="/deleteDepartment/<%= dept._id %>" 
                        method="POST"
                        onsubmit="return confirmDelete()"
                        style="display:inline;">
                    <button type="submit" class="delete-btn">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>

          <% } else { %>

            <tr>
              <td colspan="4" style="text-align:center;">No departments found.</td>
            </tr>

          <% } %>

        </tbody>
      </table>

      <!-- PAGINATION -->
      <div class="pagination">

        <% if (currentPage > 1) { %>
          <a href="/Departments?page=<%= currentPage - 1 %>" class="page-btn">Previous</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a 
            href="/Departments?page=<%= i %>" 
            class="page-btn <%= i === currentPage ? 'active' : '' %>">
            <%= i %>
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="/Departments?page=<%= currentPage + 1 %>" class="page-btn">Next</a>
        <% } %>

      </div>

    </div>

  </main>

  <script>
    function confirmDelete() {
      return confirm("Are you sure you want to delete this department?");
    }
  </script>

</body>
</html>
