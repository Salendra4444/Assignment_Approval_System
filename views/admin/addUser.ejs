<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add User</title>
  <link rel="stylesheet" href="/addUser.css">
</head>

<body>
  <main>
    <%- include('partials/leftPartial') %>

    <div id="right">
      <h1>Add User</h1>

      <form action="/add-users" method="POST" class="user-form">

        <!-- === Row 1: Name + Email === -->
        <div class="row">
          <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" placeholder="Enter full name" required>
            <p id="errName"></p>
          </div>

          <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" placeholder="example@email.com" required>
            <p id="errEmail"></p>
          </div>
        </div>

        <!-- === Row 2: Password + Phone === -->
        <div class="row">
          <div class="form-group">
            <label for="password">Password:</label>
            <input type="password" id="password" name="password" placeholder="Enter password" required>
            <p id="errPassword"></p>
          </div>

          <div class="form-group">
            <label for="phone">Phone:</label>
            <input type="number" id="phone" name="phone" placeholder="Enter phone number" pattern="[0-9]{10}" required>
            <p id="errPhone"></p>
          </div>
        </div>

        <!-- === Row 3: Department + Role === -->
        <div class="row">
          <div class="form-group">
            <label for="department">Department:</label>
            <select id="department" name="department" required>
              <% alldepartments.forEach((element)=>{ %>
                <option value="<%=element.departmentName%>"><%=element.departmentName%></option>
              <% }) %>
            </select>
            <p id="errDept"></p>
          </div>

          <div class="form-group">
            <label for="role">Role:</label>
            <select id="role" name="role" required>
              <option value="Student">Student</option>
              <option value="Professor">Professor</option>
              <option value="H.O.D">H.O.D</option>
            </select>
            <p id="errRole"></p>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="submit-btn">Register</button>
      </form>
    </div>
  </main>
</body>

</html>
