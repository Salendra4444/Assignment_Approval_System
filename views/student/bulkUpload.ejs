<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Assignment</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <div class="flex">

        <!-- Sidebar Partial -->
        <%- include("partials/navBar") %>

        <!-- Main Content -->
        <main class="flex-1 p-10">

            <h1 class="text-3xl font-semibold mb-8">Upload Assignment</h1>

            <div class="bg-white p-8 rounded-2xl shadow-lg max-w-3xl mx-auto border border-gray-200">

                <form action="/uploadBulkAssignments" method="POST" enctype="multipart/form-data" class="space-y-8">

                    <!-- Row 1: Title + Category -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <!-- Title -->
                        <div>
                            <label class="block mb-2 text-sm font-semibold text-gray-700">Title</label>
                            <input type="text" name="title"
                                class="w-full p-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
                                placeholder="Enter assignment title" required>
                        </div>

                        <!-- Category -->
                        <div>
                            <label class="block mb-2 text-sm font-semibold text-gray-700">Category</label>
                            <select name="category"
                                class="w-full p-3 border border-gray-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
                                required>
                                <option value="">Select Category</option>
                                <option value="Assignment">Assignment</option>
                                <option value="Thesis">Thesis</option>
                                <option value="Report">Report</option>
                            </select>
                        </div>

                    </div>

                    <!-- Row 2: Description + File Upload -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <!-- Description -->
                        <div>
                            <label class="block mb-2 text-sm font-semibold text-gray-700">Description</label>
                            <textarea name="description" rows="6"
                                class="w-full p-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition resize-none"
                                placeholder="Write a short description..." required></textarea>
                        </div>

                        <!-- File Upload -->
                        <div>
                            <label class="block mb-2 text-sm font-semibold text-gray-700">Upload File</label>

                            <div
                                class="border border-gray-300 rounded-xl p-3 bg-gray-50 hover:bg-gray-100 transition cursor-pointer">
                                <input type="file" name="files"
                                    class="w-full text-sm text-gray-700 focus:outline-none"
                                    accept=".pdf,.doc,.docx,.ppt,.pptx,.zip" required multiple>
                            </div>

                            <p class="text-xs text-gray-500 mt-1">Allowed: PDF only</p>
                        </div>

                    </div>

                    <!-- Submit Button -->
                    <button type="submit"
                        class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold py-3 rounded-xl text-sm transition-all shadow-md hover:shadow-lg">
                        Submit Assignment
                    </button>

                </form>

            </div>

        </main>

    </div>

</body>

</html>
