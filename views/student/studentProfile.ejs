<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <div class="flex">

        <!-- Sidebar -->
        <%- include("partials/navBar") %>

        <!-- Profile Content -->
        <main class="flex-1 p-10">

            <h1 class="text-2xl font-semibold mb-6 text-center">My Profile</h1>

            <% if (message) { %>
                <div class="max-w-xl mx-auto mb-4 rounded-lg bg-green-100 px-4 py-3 text-green-800"><%= message %></div>
            <% } %>
            <% if (error) { %>
                <div class="max-w-xl mx-auto mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800"><%= error %></div>
            <% } %>

            <div class="bg-white rounded-xl shadow p-8 max-w-xl mx-auto">

                <!-- Profile Icon -->
                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full bg-gray-300 flex items-center justify-center text-4xl font-bold text-gray-600">
                        <!-- If user image not available, show first letter -->
                        <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                    </div>

                    <h2 class="text-2xl font-semibold mt-4"><%= user.name || 'User' %></h2>
                    <p class="text-gray-500"><%= user.email || 'Email unavailable' %></p>
                </div>

                <!-- User Details -->
                <div class="mt-8 space-y-4">

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Full Name</span>
                        <span class="text-gray-600"><%= user.name || 'Not provided' %></span>
                    </div>

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Email</span>
                        <span class="text-gray-600"><%= user.email || 'Not provided' %></span>
                    </div>

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Phone Number</span>
                        <span class="text-gray-600"><%= user.phone || 'Not provided' %></span>
                    </div>

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Department</span>
                        <span class="text-gray-600"><%= user.departement || 'Assigned by admin' %></span>
                    </div>

                </div>

                <div class="mt-8 border-t pt-6">
                    <h3 class="text-lg font-semibold text-gray-800">Update phone number</h3>
                    <form action="/studentProfile/phone" method="POST" class="mt-4 flex gap-3">
                        <input type="tel" name="phone" value="<%= user.phone || '' %>" pattern="[0-9]{10}" maxlength="10"
                            placeholder="10-digit phone number" required
                            class="min-w-0 flex-1 rounded-lg border border-gray-300 p-3 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                        <button type="submit" class="rounded-lg bg-emerald-700 px-4 py-3 font-semibold text-white hover:bg-emerald-800">Save</button>
                    </form>
                </div>

                <div class="mt-8 border-t pt-6">
                    <h3 class="text-lg font-semibold text-gray-800">Reset password</h3>
                    <form action="/studentProfile/reset-password" method="POST" class="mt-4 space-y-3">
                        <input type="password" name="newPassword" minlength="6" placeholder="New password" required
                            class="w-full rounded-lg border border-gray-300 p-3 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                        <input type="password" name="confirmPassword" minlength="6" placeholder="Confirm new password" required
                            class="w-full rounded-lg border border-gray-300 p-3 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500">
                        <button type="submit" class="rounded-lg bg-slate-800 px-4 py-3 font-semibold text-white hover:bg-slate-900">Reset password</button>
                    </form>
                </div>

            </div>

        </main>
    </div>

</body>

</html>
