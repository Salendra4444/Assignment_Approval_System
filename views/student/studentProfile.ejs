<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <div class="flex">

        <!-- Sidebar -->
        <%- include("partials/navBar") %>

        <!-- Profile Content -->
        <main class="flex-1 p-10">

            <h1 class="text-2xl font-semibold mb-6 text-center">My Profile</h1>

            <div class="bg-white rounded-xl shadow p-8 max-w-xl mx-auto">

                <!-- Profile Icon -->
                <div class="flex flex-col items-center">
                    <div class="w-28 h-28 rounded-full bg-gray-300 flex items-center justify-center text-4xl font-bold text-gray-600">
                        <!-- If user image not available, show first letter -->
                        <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                    </div>

                    <h2 class="text-2xl font-semibold mt-4"><%= user.name %></h2>
                    <p class="text-gray-500"><%= user.email %></p>
                </div>

                <!-- User Details -->
                <div class="mt-8 space-y-4">

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Full Name</span>
                        <span class="text-gray-600"><%= user.name %></span>
                    </div>

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Email</span>
                        <span class="text-gray-600"><%= user.email %></span>
                    </div>

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Phone Number</span>
                        <span class="text-gray-600"><%= user.phone %></span>
                    </div>

                    <div class="flex justify-between border-b pb-3">
                        <span class="font-medium text-gray-700">Department</span>
                        <span class="text-gray-600"><%= user.departement %></span>
                    </div>

                </div>

            </div>

        </main>
    </div>

</body>

</html>
