<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Assignments</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

    <div class="flex">

        <!-- Sidebar -->
        <%- include("partials/navBar", { activePage: "assignments" }) %>

        <!-- MAIN CONTENT -->
        <main class="flex-1 px-10 py-8">

            <h1 class="text-3xl font-bold text-gray-800 mb-8">My Assignments</h1>

            <!-- FILTERS -->
            <form action="/professor/myReview" method="GET" class="flex flex-wrap gap-4 items-center mb-6">

                <!-- STATUS FILTER -->
                <select name="status" class="border rounded px-3 py-2">
                    <option value="">All Status</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>

                <!-- SORT BY DATE -->
                <select name="sort" class="border rounded px-3 py-2">
                    <option value="new">Newest First</option>
                    <option value="old">Oldest First</option>
                </select>

                <button type="submit" class="bg-green-600 text-white px-5 py-2 rounded hover:bg-green-700">
                    Apply
                </button>

            </form>

            <!-- TABLE -->
            <div class="bg-white p-6 rounded-xl shadow-md">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b">
                            <th class="py-3 px-2 font-semibold">Title</th>
                            <th class="py-3 px-2 font-semibold">Category</th>
                            <th class="py-3 px-2 font-semibold">Status</th>
                            <th class="py-3 px-2 font-semibold">Submitted Date</th>
                            <th class="py-3 px-2 font-semibold">Reviewer</th>
                            <th class="py-3 px-2 font-semibold"></th> <!-- Actions -->
                        </tr>
                    </thead>

                    <tbody>
                        <% assignments.forEach(assign => { %>
                        <tr class="border-b hover:bg-gray-50">

                            <!-- TITLE -->
                            <td class="py-3 px-2"><%= assign.title %></td>

                            <!-- CATEGORY -->
                            <td class="py-3 px-2"><%= assign.category %></td>

                            <!-- STATUS BADGE -->
                            <td class="py-3 px-2">
                                <% if(assign.status === "Submitted"){ %>
                                    <span class="bg-orange-400 text-white px-3 py-1 rounded text-sm">Submitted</span>
                                <% } else if(assign.status === "Approved"){ %>
                                    <span class="bg-green-500 text-white px-3 py-1 rounded text-sm">Approved</span>
                                <% } else { %>
                                    <span class="bg-red-500 text-white px-3 py-1 rounded text-sm">Rejected</span>
                                <% } %>
                            </td>

                            <!-- DATE -->
                            <td class="py-3 px-2">
                                <%= assign.submittedAt ? new Date(assign.submittedAt).toLocaleDateString() : "-" %>
                            </td>

                            <!-- REVIEWER -->
                            <td class="py-3 px-2"><%= assign.reviewer || "-" %></td>

                            <!-- ACTION BUTTONS -->
                            <td class="py-3 px-2 text-right">

                                <% if(assign.status === "Submitted"){ %>
                                    <a href="/professor/review/<%= assign._id %>"
                                       class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-1 rounded">
                                       Review
                                    </a>

                                <% } else if(assign.status === "Approved"){ %>
                                    <span class="text-green-600 font-semibold">✔ Approved</span>

                                <% } else { %>
                                    <span class="text-red-600 font-semibold">✘ Rejected</span>
                                <% } %>

                            </td>

                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>


            <!-- PAGINATION -->
            <div class="flex justify-center mt-6 gap-2">
                <% for(let i=1; i<=pages; i++){ %>
                    <a href="?page=<%= i %>"
                       class="px-4 py-2 rounded border 
                       <%= i==currentPage ? 'bg-green-600 text-white' : 'bg-white text-gray-700 hover:bg-gray-200' %>">
                       <%= i %>
                    </a>
                <% } %>
            </div>

        </main>
    </div>

</body>
</html>
